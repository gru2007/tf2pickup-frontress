#
# Required
#

# Where the site is opened. Steam sends players back here after signing in.
WEBSITE_URL=https://mm.team-frontress.org

# Signs the session cookie: a long random string (openssl rand -hex 32).
# Changing it signs everybody out.
SESSION_SECRET=change-me-to-a-long-random-string

# The Frontress game coordinator (services/gc in team-frontress).
GC_URL=http://127.0.0.1:27100

# The coordinator's admin key (gc.json admin_key or $GC_ADMIN_KEY on the GC).
# Without it the admin panel and the private part of a player's own profile
# (bans, quests, donations) are off.
GC_ADMIN_KEY=

# The coordinator's address as game servers reach it, shown with a new
# server key for server.cfg. Default: GC_URL.
GC_PUBLIC_URL=

# Moderators (bans, reports, ending matches, logs) and super users (also
# payments, the coordinator's settings and server keys).
# SteamID64s, comma-separated.
ADMINS=
SUPER_USERS=

#
# Optional
#

# Steam web API key: player names and avatars. Without it the names the game
# reported and a default avatar are shown. https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

WEBSITE_NAME=Team Frontress
# Links in the navigation bar
DOWNLOAD_URL=
DISCORD_INVITE_URL=

# Map pictures for game lists
#THUMBNAIL_SERVICE_URL=https://mapthumbnails.tf2pickup.org

# development or production; the Docker image already sets production
#NODE_ENV=development
#LOG_LEVEL=info
#APP_HOST=localhost
#APP_PORT=3000

# Reverse-proxy addresses whose X-Forwarded-* headers are trusted.
#TRUST_PROXY=loopback, uniquelocal
