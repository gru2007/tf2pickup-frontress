{
  "name": "frontress-portal",
  "version": "4.25.4",
  "author": "Michał Garapich <garrappachc@gmail.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "tsx --watch src/main.ts",
    "xss-scan": "xss-scan",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest --dir src --run",
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "postbuild": "cpy public dist && cpy src/**/*.md src/**/*.css dist/src && find src -wholename \"*/@client/*.ts\" -exec cp --parents '{}' dist ';'"
  },
  "dependencies": {
    "@fastify/accepts": "5.0.7",
    "@fastify/autoload": "6.5.1",
    "@fastify/etag": "6.2.2",
    "@fastify/flash": "6.0.6",
    "@fastify/formbody": "9.0.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/proxy-addr": "5.1.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/request-context": "7.0.5",
    "@fastify/secure-session": "8.4.2",
    "@fastify/sensible": "6.0.7",
    "@fastify/static": "10.1.10",
    "@kitajs/fastify-html-plugin": "4.2.1",
    "@kitajs/html": "4.2.13",
    "@kitajs/ts-html-plugin": "4.1.4",
    "@tailwindcss/postcss": "4.3.4",
    "@tailwindcss/typography": "0.5.20",
    "cssnano": "9.9.0",
    "date-fns": "4.4.0",
    "dotenv": "18.0.9",
    "es-toolkit": "1.53.2",
    "esbuild": "0.28.2",
    "fastify": "5.12.8",
    "fastify-disablecache": "5.0.1",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "htmx-ext-head-support": "2.0.5",
    "htmx-ext-preload": "2.1.2",
    "htmx-ext-remove-me": "2.0.2",
    "htmx.org": "2.0.11",
    "marked": "18.1.3",
    "mime": "4.1.2",
    "motion": "14.9.1",
    "openid": "2.0.18",
    "package-up": "5.0.0",
    "pino": "10.4.0",
    "postcss": "8.5.32",
    "postcss-nested": "9.0.1",
    "sanitize-html": "2.18.1",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.6",
    "@types/openid": "2.0.5",
    "@types/sanitize-html": "2.16.2",
    "cpy-cli": "7.0.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "node-html-parser": "9.0.7",
    "pino-princess": "1.6.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "release-it": "21.1.2",
    "rimraf": "6.1.4",
    "tsc-alias": "1.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
